<Window x:Class="Ostrasort.Gui.ImportListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import a mod list" Width="600" Height="560" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="18,14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="Paste a share code from another player or a Steam Workshop collection link, or open a list file."/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Open file…" Padding="12,4" Margin="8,0,0,0" Click="OpenFile_Click"/>
                <Button x:Name="BtnCheck" Content="Check" Padding="12,4" Margin="8,0,0,0" IsDefault="True" Click="Check_Click"/>
            </StackPanel>
            <TextBox x:Name="TxtSource" Height="54" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" Padding="3,2"/>
        </DockPanel>
        <TextBlock x:Name="TxtSummary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnSave" Content="Save as profile" Padding="12,4" Margin="8,0,0,0" IsEnabled="False" Click="Save_Click"/>
                <Button Content="Close" Padding="12,4" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
            <TextBlock Text="Profile name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtName" VerticalAlignment="Center" Padding="3,2"/>
        </DockPanel>
        <StackPanel x:Name="PanelMissingButtons" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
            <Button x:Name="BtnOpenSelected" Content="Open selected on Steam" Padding="12,4" Click="OpenSelected_Click"/>
            <Button x:Name="BtnOpenCollection" Content="Open the collection on Steam" Padding="12,4" Margin="8,0,0,0" Click="OpenCollection_Click"
                    ToolTip="The collection page has a Subscribe to all button."/>
        </StackPanel>
        <ListBox x:Name="ListMissing" SelectionMode="Extended" MouseDoubleClick="OpenSelected_Click">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
