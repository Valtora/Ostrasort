<Window x:Class="Ostrasort.Gui.CulpritHuntDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find a problem mod" SizeToContent="Height" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18,14">
        <TextBlock x:Name="TxtTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock x:Name="TxtBody" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock x:Name="TxtList" TextWrapping="Wrap" Margin="12,0,0,8" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock x:Name="TxtHint" TextWrapping="Wrap" Margin="0,0,0,8" FontStyle="Italic"/>
        <WrapPanel HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="BtnStart" Content="Start" Padding="14,4" Margin="8,4,0,0" IsDefault="True" Click="Start_Click"/>
            <Button x:Name="BtnLaunch" Content="Launch game" Padding="14,4" Margin="8,4,0,0" Click="Launch_Click"/>
            <Button x:Name="BtnBroken" Content="Problem still happens" Padding="14,4" Margin="8,4,0,0" Click="Broken_Click"/>
            <Button x:Name="BtnGone" Content="Problem is gone" Padding="14,4" Margin="8,4,0,0" Click="Gone_Click"/>
            <Button x:Name="BtnKeepOff" Content="Restore my mods, keep it off" Padding="14,4" Margin="8,4,0,0" Click="KeepOff_Click"/>
            <Button x:Name="BtnRestore" Content="Restore all my mods" Padding="14,4" Margin="8,4,0,0" Click="Restore_Click"/>
            <Button x:Name="BtnStop" Content="Stop the hunt" Padding="14,4" Margin="8,4,0,0" Click="Restore_Click"/>
            <Button x:Name="BtnClose" Content="Close" Padding="14,4" Margin="8,4,0,0" IsCancel="True"/>
        </WrapPanel>
    </StackPanel>
</Window>
